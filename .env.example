# ───────────────────────────────────────────────────────────
# ROAR MMA — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ───────────────────────────────────────────────────────────

# Canonical site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.roarmartialarts.com

# Contact form provider: resend | formspree | none
# "none" (default) falls back to opening WhatsApp pre-filled with the form data.
FORM_PROVIDER=none

# Formspree endpoint (only if FORM_PROVIDER=formspree)
FORMSPREE_ENDPOINT=

# Resend (only if FORM_PROVIDER=resend) — server-side only, never exposed to client
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Google Analytics 4 (optional). If empty, no analytics script loads.
NEXT_PUBLIC_GA_ID=
